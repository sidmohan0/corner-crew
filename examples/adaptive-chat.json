{
  "model": "@auto",
  "user_id": "demo-user",
  "messages": [{"role": "user", "content": "Explain a Python dictionary in one sentence."}],
  "policy": {
    "privacy": "confidential",
    "data_residency": "US",
    "providers": ["openai", "anthropic", "google", "local"],
    "risk_tier": "standard",
    "on_policy_violation": "reject"
  },
  "budget": {
    "max_total_cost_usd": 0.05,
    "max_latency_ms": 8000,
    "max_wall_time_ms": 20000,
    "max_model_calls": 4,
    "max_reasoning_tokens": 10000,
    "on_exceeded": "best_effort"
  },
  "compute": {
    "strategy": "adaptive",
    "initial_tier": "cheap",
    "max_tier": "frontier",
    "reasoning_effort": "adaptive",
    "escalate_on": ["complexity", "low_confidence", "verification_failure"],
    "on_escalation_failure": "best_available"
  },
  "verification": {
    "mode": "adaptive",
    "triggers": ["low_confidence", "high_risk_domain", "factual_claims", "code_generation"],
    "strategies": ["independent_model", "tool_check", "schema_validation", "consensus"],
    "failure_action": "return_with_uncertainty"
  },
  "consensus": {
    "trigger": {"confidence_below": 0.82},
    "min_independent_families": 3,
    "diversity": {"vendors": true, "model_families": true},
    "aggregation_strategy": "@majority",
    "disagreement": "return_with_uncertainty"
  },
  "memory": {
    "scope": "user",
    "read": true,
    "write": "auto",
    "retention": "persistent",
    "conflict_strategy": "prefer_recent"
  },
  "routing": {
    "strategy": "adaptive",
    "optimize": ["quality", "cost", "latency"],
    "optimization_mode": "balanced",
    "fallback": "next_best",
    "provider_selection": "policy_allowed"
  },
  "response": {"uncertainty": "when_material", "citations": "auto", "format": "auto"}
}
