# Set keys and registered model IDs from your provider accounts.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Start llama-server with --alias local-model (see README).
# Placeholder key for the SDK; default llama-server does not require authentication.
LOCAL_BASE_URL=http://127.0.0.1:8080/v1/
LOCAL_API_KEY=local
LOCAL_MODEL=local-model
REQUEST_TIMEOUT_SECONDS=120

# Separate llama.cpp instance for MiniCPM5 2B.
MINICPM_BASE_URL=http://127.0.0.1:8081/v1/
MINICPM_API_KEY=local
MINICPM_MODEL=MiniCPM5-2B

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Required for a residency-constrained request. Leave unset until confirmed.
# LOCAL_DATA_RESIDENCY=US
MEMORY_PATH=.data/memory.sqlite3
# JSON deployment metadata keyed by openai, gemini, anthropic, local, minicpm.
# Cloud input/output prices must be provided before paid calls are allowed.
# Do not copy example prices as current pricing. Set exact configured model ID.
# MODEL_METADATA={"openai":{"model":"YOUR_MODEL_ID","region":"US","confidential_approved":true,"input_usd_per_million":1.0,"output_usd_per_million":4.0,"tier":"frontier","family":"gpt","vendor":"openai"}}
